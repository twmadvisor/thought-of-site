{
  "expo": {
    "name": "thought of",
    "slug": "thought-of",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/thought-of-logo.png",
    "userInterfaceStyle": "light",
    "scheme": "thoughtof",
    "splash": {
      "image": "./assets/thought-of-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thoughtof.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.thoughtof.app"
    },
    "plugins": ["expo-notifications"]
  }
}
