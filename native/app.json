{
  "expo": {
    "name": "thought of",
    "slug": "thought-of",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "thoughtof",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thoughtof.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.thoughtof.app"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow thought of to choose a profile photo.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a6a1c542-e326-4642-8e47-e585d603c218"
      }
    },
    "owner": "twmadvisor"
  }
}
